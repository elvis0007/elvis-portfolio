NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Supabase → Connect (o Project Settings → API Keys) → Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# (Proyectos antiguos: también funciona NEXT_PUBLIC_SUPABASE_ANON_KEY)

# Opcional: protege la tarea diaria que mantiene Supabase activo (Vercel la envía sola)
CRON_SECRET=

# URL pública del sitio (SEO, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
